kis.base-url=https://openapi.koreainvestment.com:9443
kis.app-key=USERKEY
kis.app-secret=USERSECRETKEY
kis.account-no=00000000
kis.acnt-prdt-cd=0000000000
kis.mode=real

# REST는 kis / kiwoom 중 기동 시 선택합니다. Kiwoom은 별도 인증 활성화/자격증명이 필요합니다.
marketdata.provider=kis
# 현재가에 우선 연결한 Provider·실제 요청 환경별 JVM REST Circuit Breaker입니다.
# KIS·Kiwoom 공통 정책이며 차트/순위 등 다른 REST API·WS는 아직 연결하지 않습니다.
# 5xx·통신 장애만 실패 집계합니다. 캐시/로컬 한도·토큰·인증·업무 오류는 집계하지 않습니다.
# OPEN은 토큰/시세 HTTP 전에 거절합니다. 자동 전환·추가 fallback은 없습니다.
# 변경 후 재시작하며 재시작 시 CB 상태/표본도 초기화됩니다.
marketdata.circuit-breaker.enabled=true
marketdata.circuit-breaker.window-size=10
marketdata.circuit-breaker.minimum-calls=5
marketdata.circuit-breaker.failure-rate=50
marketdata.circuit-breaker.open-seconds=30
marketdata.circuit-breaker.half-open-calls=1
# 실시간 WS는 REST 선택과 독립입니다. 현재 등록된 구현은 kis입니다.
marketdata.realtime-provider=kis

# WS approval와 연결 주소도 kis.mode를 사용합니다. 환경/키 변경은 재시작 후 적용합니다.
# real: approval 9443 / WS 21000, virtual: approval 29443 / WS 31000
# 모의도 기존 15:30 통합·자정 KRX 전환을 유지합니다. 통합 TR의 모의 지원·실수신은 검증 필요입니다.

# 현재 연결의 무수신 제한(ms)입니다. ACK 제한 5000ms보다 크게 설정합니다.
kis.websocket.receive-timeout-millis=90000

# KIS 시세 REST의 환경·계좌별 JVM 호출 예산입니다. 변경 후 재시작합니다.
# 실전은 1~18, 모의는 1만 허용합니다. 신규 고객은 실제 적용 한도에 맞게 실전을 직접 낮춥니다.
# 토큰/approval 발급·마스터 다운로드·다른 프로세스 호출은 이 예산에 포함되지 않습니다.
kis.rest.rate-limit.real-per-second=18
kis.rest.rate-limit.virtual-per-second=1

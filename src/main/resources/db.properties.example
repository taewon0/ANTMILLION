#데이터베이스
db.driver=DRIVER NAME
db.url=YOUR URL
db.username=YOUR NAME
db.password=YOUR PASSWORD
#레디스
redis.host=VALUE
redis.port=VALUE
# JWT 토큰 설정
jwt.secret=VALUE
jwt.access-ttl-seconds=900
jwt.refresh-ttl-seconds=1209600
#카카오 연동
kakao.client-id=VALUE
kakao.client-secret=
kakao.redirect-uri=VALUE
# 메일 설정
mail.host=VALUE
mail.port=VALUE
mail.username=VALUE
mail.password=VALUE
mail.from=VALUE
mail.smtp.auth=true
mail.smtp.starttls.enable=true
mail.smtp.starttls.required=true
mail.smtp.ssl.trust=VALUE
mail.debug=false
mail.verify.code-ttl-seconds=300
mail.verify.verified-ttl-seconds=1800

# 일일 종목 동기화는 마이그레이션 001·002를 적용한 뒤 명시적으로 활성화합니다.
stock.sync.enabled=false
stock.sync.cron=0 0 18 * * *
stock.sync.zone=Asia/Seoul
